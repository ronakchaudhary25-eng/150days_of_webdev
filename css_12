<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CSS media queries</title>
    <style>
      body {
        background-color: blue;
      }
       /*
       syntax of media querry 
        @media not|only mediatype and (expressions) {
            CSS-Code;
        } */

        /* landscape orientation : width>height (horizontal direction)*/
        /* potrate orientation : height>width (vertical diraction) */

     @media screen and (orientation : portrait){
        body{
            border : 5px solid black;
        }
     }


      @media only screen and (max-width: 400px) {
        body {
          background-color: red;
        }
        .boxes{
            flex-direction: column;
        }
      }
      .boxes{
        display : flex;
      }
      .dabba{
        border : 5px solid mediumaquamarine;
        margin : 3px;
        padding : 5px;
        width : 75vw;
        height : 50vh;
      }
    </style>
  </head>
  <body>
    <div>hey am a body !!</div>
    <div class="boxes">
        <div class="dabba"></div>
        <div class="dabba"></div>
        <div class="dabba"></div>
    </div>
  </body>
</html>
