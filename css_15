<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CSS flexbox</title>
    <style>
      .container{
          border : 2px solid black;
          display:flex;
          height:800px;
          justify-content: center;
          /* alignitem centre to centre when we have  1line content */
          /* align-items: center; */
          /* align content : centre when we have more than 1line content */
          align-content: center;
          flex-direction:row;
          /* flex-direction: column-reverse;
          flex-direction: row-reverse; */
          /* flex direction if content is overflowed */
          /* flex-wrap: wrap; */
          /* flex-direction + flex-wrap dono ek sath*/
          flex-flow: row wrap;
          /* gap: 30px;
              row-gap: 40px;
              column-gap: 10px; */
          gap: 40px 10px;

      }
      .item{
          height : 180px;
          width : 215px;
          border : 2px solid red;
          background-color: gold;
          margin:5px;
      }
      /*  defualt order for all elements is 0 */
      /* higher is the order utna peeche element hoga sequence mein */
      .order-1{
            order: 1;
        }
        .order-2{
            order: 2;
        }
        .order-3{
            order: 3;
        }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="item order-1"">1</div>
      <div class="item">2</div>
      <div class="item">3</div>
      <div class="item">4</div>
      <div class="item">5</div>
      <div class="item">6</div>
      <div class="item">7</div>
      <div class="item">8</div>
      <div class="item">9</div>
      <div class="item">10</div>
    </div>
  </body>
</html>
