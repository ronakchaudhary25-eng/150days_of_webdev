<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Animation</title>
    <style>
        .container{
            background-color: rgb(9, 106, 106);
            height: 80vh;
            width: 30vw;
        }
        .box{
          width: 45px;
          height: 45px; 
          /* background-color: red; */
          /* animation-name: animatebox;
          animation-duration: 1s;
          animation-iteration-count: infinite;
          animation-timing-function: cubic-bezier(0,0, 0,0.96); */

          /* gap between end of 1st iteration and upcoming iteration */
          /* animation-delay: 1s;
          animation-direction: alternate-reverse; */

          /* animation pause ke lie  */
          /* animation-play-state: paused; */
          
          /* animation: name duration timing-function delay iteration-count direction fill-mode; */
          animation:animatebox 1s cubic-bezier(0,0, 0,0.96) 1s 1  forwards;
          /* fill mode : forwards and backwards  */
        }
         @keyframes animatebox {
            from{
                background-color: black;
            }
            to{
                background-color: gold;  
                transform : translateX(1000px); 
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="box">
            BOX!
        </div>
    </div>
</body>
</html>
