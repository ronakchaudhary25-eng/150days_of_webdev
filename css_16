<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CSS Transform</title>
    <style>
        .box1 {
            width: 90px;
            height: 90px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: aqua;
            border: 2px solid black;
            transform: rotate(45deg);
        }
      .box2 {
        width: 90px;
        height: 90px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: gold;
        border: 2px solid black;
        /* roatate by 90 degrees */
        transform: rotate(0.5turn);
      }
      .box3{
        width: 90px;
        height: 90px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: red;
        border: 2px solid black;
        /* scale by 1.5 times */
        transform: rotateZ(45deg);
        /* scale : increase or decrease size of element in the particular axis*/
        transform : scaleZ(3);
        /* skew : stretching in particular axis */
        transform: skewY(10deg);
      }
      .box4{
        width: 90px;
        height: 90px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: green;
        border: 2px solid black;
        /* translate : moving the element in particular axis */
        transform : translateX(100px);
        transform-origin: -0% ,-0%;
      }
      .box5{
        width: 90px;
        height: 90px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: yellow;
        border: 2px solid black;
        /* transform : multiple transformation in one element */
        transform : translateX(100px) rotate(45deg) scale(1.5);
        transform-origin: -0% ,-0%;

      }
      .container {
        border: 2px solid black;
        width: 80vw;
        height: 80vh;
        margin: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 100px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="box1">BOX1</div>
      <div class="box2">BOX2</div>
      <div class="box3">BOX3</div>
      <div class="box4">BOX4</div>
      <div class="box5">BOX5</div>
    </div>
  </body>
</html>
