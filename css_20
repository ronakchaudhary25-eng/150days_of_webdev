<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Filters</title>
    <style>
    img1{
        filter: brightness(125%);
    }
    img2{
        filter: contrast(200%);
        /* filter: invert(0.5); */
        /* filter: opacity(0.5); */
    }
    /* gray scale 100 krte hi black and white banjayega */
    img3{
        filter: drop-shadow(16px 16px 20px red);
        /* filter: sepia(100%); */
       /*more filters on MDN reference : https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/filter  */
    }
    </style>
</head>
<body>
    <div class="container"> 
        <img class="img1" src="https://img.freepik.com/free-photo/programming-background-with-person-working-with-codes-computer_23-2150010125.jpg?size=626&ext=jpg" alt="">
        <img class="img2" src="https://c.ndtvimg.com/2023-09/154fgjlg_shah-rukh-khan-_625x300_23_September_23.jpg" alt="SRK">
        <img class="img3" src="https://images.hindustantimes.com/img/2022/11/12/550x309/akshay_kumar_1659860706633_1668255913307_1668255913307.jpg" alt="AK">
    </div>
</body>
</html>
